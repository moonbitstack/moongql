name = "moonbitstack/moongql"

version = "0.11.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moongql"

license = "Apache-2.0"

keywords = [
  "graphql",
  "gql",
  "graphql-server",
  "schema",
  "sdl",
  "code-first",
  "query",
  "mutation",
  "subscription",
  "resolver",
  "federation",
  "apollo-federation",
  "federation-v2",
  "dataloader",
  "introspection",
  "validation",
  "schema-validation",
  "type-system",
  "directive",
  "graphiql",
  "annotations",
  "strawberry",
  "moonbit",
]

description = "Code-first GraphQL for MoonBit."

import {
  "moonbitstack/moonasgi@0.11.1",
  "moonbitstack/moonjson@0.5.0",
  "moonbitstack/moonfetch@0.1.8",
  "moonbitstack/moonast@0.3.0",
  "moonbitlang/parser@0.4.8",
  "moonbitlang/x@0.5.7",
  "moonbitlang/async@0.22.5",
  "moonbitstack/moondb@0.3.0",
  "moonbitstack/moonorm@0.11.10",
  "moonbitstack/moonmcp@0.1.12",
  "moonbitstack/moonsqlite@0.4.0",
}

source = "src"
