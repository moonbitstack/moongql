name = "moonbitstack/moongql"

version = "0.10.8"

readme = "README.md"

repository = "https://github.com/moonbitstack/moongql"

license = "Apache-2.0"

keywords = [
  "graphql",
  "gql",
  "graphql-server",
  "schema",
  "sdl",
  "code-first",
  "query",
  "mutation",
  "subscription",
  "resolver",
  "federation",
  "apollo-federation",
  "dataloader",
  "introspection",
  "validation",
  "directive",
  "graphiql",
  "annotations",
  "strawberry",
  "moonbit",
]

description = "Code-first GraphQL for MoonBit."

import {
  "moonbitstack/moonasgi@0.10.4",
  "moonbitstack/moonast@0.2.4",
  "moonbitlang/parser@0.4.6",
  "moonbitlang/x@0.5.1",
  "moonbitlang/async@0.22.5",
}

source = "src"
