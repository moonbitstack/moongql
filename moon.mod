name = "moonbitstack/moongql"

version = "0.10.10"

readme = "README.md"

repository = "https://github.com/moonbitstack/moongql"

license = "Apache-2.0"

keywords = [
  "graphql",
  "gql",
  "graphql-server",
  "schema",
  "sdl",
  "code-first",
  "query",
  "mutation",
  "subscription",
  "resolver",
  "federation",
  "apollo-federation",
  "federation-v2",
  "dataloader",
  "introspection",
  "validation",
  "schema-validation",
  "type-system",
  "directive",
  "graphiql",
  "annotations",
  "strawberry",
  "moonbit",
]

description = "Code-first GraphQL for MoonBit."

import {
  "moonbitstack/moonasgi@0.10.6",
  "moonbitstack/moonfetch@0.1.6",
  "moonbitstack/moonast@0.2.6",
  "moonbitlang/parser@0.4.6",
  "moonbitlang/x@0.5.1",
  "moonbitlang/async@0.22.5",
  "moonbitstack/moondb@0.2.7",
  "moonbitstack/moonorm@0.11.9",
  "moonbitstack/moonmcp@0.1.11",
  "moonbitstack/moonsqlite@0.3.6",
}

source = "src"
