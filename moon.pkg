// moongql (<- strawberry-graphql). The code-first schema (schema.mbt) plus the
// executable pipeline: lexer -> parser -> AST -> validator -> executor with a
// resolver map, variables, aliases, fragments, @skip/@include and introspection.
// Pure logic, all backends; JSON in/out via core/json, literal coercion via
// core/strconv.
import {
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitstack/moonasgi",
}
