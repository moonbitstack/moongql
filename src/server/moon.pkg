// Serving over HTTP and over the graphql-ws protocol, through moonasgi. A
// subpackage because it is the only half that needs moonasgi: running a query
// in-process does not.
import {
  "moonbitstack/moongql/lang",
  "moonbitstack/moongql/schema",
  "moonbitstack/moongql/valid",
  "moonbitstack/moongql/exec",
  "moonbitstack/moonasgi",
  "moonbitstack/moonasgi/ws",
  "moonbitstack/moonasgi/spec",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async",
}

import {
  "moonbitlang/async",
} for "wbtest"
